#!/usr/bin/env python3
"""bserve: serve the files under ROOT over BH/1.

    bserve ROOT PORT

PORT 0 picks a free port.  The port actually bound is printed on stderr.
Each connection gets a thread and stays open until the client closes it,
until it has been idle for IDLE_TIMEOUT seconds, or until a connection
error (SPEC.md, section 6).
"""

import email.utils
import os
import socket
import sys
import threading
import time
import urllib.parse

from bh1 import (DATA, END_STREAM, HEADERS, MAX_PAYLOAD, PREFACE, ConnectionClosed, Frame,
                 MalformedError, ProtocolError, decode_headers, encode_headers, read_exact,
                 read_frame, validate_request)

SERVER = b"bserve/1.0"
IDLE_TIMEOUT = 60.0
INDEX_FILE = "index.html"

REASONS = {
    200: "OK",
    400: "Bad Request",
    403: "Forbidden",
    404: "Not Found",
    405: "Method Not Allowed",
}

CONTENT_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".htm": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".txt": "text/plain; charset=utf-8",
    ".md": "text/markdown; charset=utf-8",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".ico": "image/x-icon",
    ".pdf": "application/pdf",
}
DEFAULT_TYPE = "application/octet-stream"

_log_lock = threading.Lock()


def log(fmt, *args):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + (fmt % args if args else fmt)
    with _log_lock:
        sys.stderr.write(line + "\n")
        sys.stderr.flush()


def http_date(ts=None):
    return email.utils.formatdate(ts, usegmt=True).encode()


class Connection:
    """One client connection: the stream bookkeeping of SPEC.md section 5."""

    def __init__(self, sock, peer, root):
        self.sock = sock
        self.peer = "%s:%d" % peer[:2]
        self.root = root
        self.last_stream = 0   # highest client stream id seen; it and everything below is closed

    def serve(self):
        try:
            self.sock.settimeout(IDLE_TIMEOUT)
            preface = read_exact(self.sock, len(PREFACE))
            if preface != PREFACE:
                log("%s bad preface %r, closing", self.peer, preface)
                return
            while True:
                frame = read_frame(self.sock)
                if frame is None:
                    return
                if frame.type == HEADERS:
                    self.handle_headers(frame)
                elif frame.type == DATA:
                    self.handle_stray_data(frame)
                # any other type is skipped: it changes nothing
        except socket.timeout:
            log("%s idle for %ds, closing", self.peer, IDLE_TIMEOUT)
        except ProtocolError as e:
            log("%s connection error: %s", self.peer, e)
        except (ConnectionClosed, OSError) as e:
            log("%s %s", self.peer, e)
        finally:
            self.sock.close()

    # -- stream rules --

    def open_stream(self, sid):
        if sid == 0 or sid % 2 == 0:
            raise ProtocolError("stream %d cannot be opened by the client" % sid)
        if sid <= self.last_stream:
            raise ProtocolError("stream %d is not above the last stream %d" % (sid, self.last_stream))
        self.last_stream = sid

    def handle_headers(self, frame):
        sid = frame.stream
        self.open_stream(sid)
        try:
            method, path, _ = validate_request(decode_headers(frame.payload))
        except MalformedError as e:
            log("%s #%d malformed request: %s", self.peer, sid, e)
            self.send_error(sid, 400, b"GET")
            return
        if not frame.flags & END_STREAM:
            self.drain_body(sid)
        self.respond(sid, method, path)

    def drain_body(self, sid):
        """Read and discard the request body: DATA frames on sid up to END_STREAM."""
        while True:
            frame = read_frame(self.sock)
            if frame is None:
                raise ConnectionClosed("connection closed inside the body of stream %d" % sid)
            if frame.type == HEADERS:
                raise ProtocolError("HEADERS on stream %d while stream %d is open" % (frame.stream, sid))
            if frame.type == DATA:
                if frame.stream == sid:
                    if frame.flags & END_STREAM:
                        return
                elif frame.stream > sid:
                    raise ProtocolError("DATA on stream %d while stream %d is open" % (frame.stream, sid))
                # DATA on an older, closed stream is ignored

    def handle_stray_data(self, frame):
        sid = frame.stream
        if sid == 0 or sid % 2 == 0:
            raise ProtocolError("DATA on stream %d, which the client cannot open" % sid)
        if sid <= self.last_stream:
            return   # the tail of a stream already answered
        self.last_stream = sid
        log("%s #%d malformed request: stream begins with DATA", self.peer, sid)
        self.send_error(sid, 400, b"GET")

    # -- responses --

    def respond(self, sid, method, path):
        if method not in (b"GET", b"HEAD"):
            self.send_error(sid, 405, method, path)
            return
        status, full = self.resolve(path)
        if status != 200:
            self.send_error(sid, status, method, path)
            return
        try:
            f = open(full, "rb")
        except PermissionError:
            self.send_error(sid, 403, method, path)
            return
        except OSError:
            self.send_error(sid, 404, method, path)
            return
        with f:
            st = os.fstat(f.fileno())
            ext = os.path.splitext(full)[1].lower()
            headers = [
                (b":status", b"200"),
                (b"content-type", CONTENT_TYPES.get(ext, DEFAULT_TYPE).encode()),
                (b"content-length", str(st.st_size).encode()),
                (b"date", http_date()),
                (b"server", SERVER),
                (b"last-modified", http_date(st.st_mtime)),
            ]
            chunk = b"" if method == b"HEAD" else f.read(MAX_PAYLOAD)
            self.send(Frame(HEADERS, 0 if chunk else END_STREAM, sid, encode_headers(headers)))
            sent = 0
            while chunk:
                nxt = f.read(MAX_PAYLOAD)
                self.send(Frame(DATA, 0 if nxt else END_STREAM, sid, chunk))
                sent += len(chunk)
                chunk = nxt
        self.access(sid, method, path, 200, sent)

    def send_error(self, sid, status, method, path=b"-"):
        body = ("%d %s\n" % (status, REASONS[status])).encode()
        headers = [
            (b":status", str(status).encode()),
            (b"content-type", b"text/plain; charset=utf-8"),
            (b"content-length", str(len(body)).encode()),
            (b"date", http_date()),
            (b"server", SERVER),
        ]
        if method == b"HEAD":
            self.send(Frame(HEADERS, END_STREAM, sid, encode_headers(headers)))
            self.access(sid, method, path, status, 0)
        else:
            self.send(Frame(HEADERS, 0, sid, encode_headers(headers)))
            self.send(Frame(DATA, END_STREAM, sid, body))
            self.access(sid, method, path, status, len(body))

    def send(self, frame):
        self.sock.sendall(frame.to_bytes())

    def access(self, sid, method, path, status, nbytes):
        log("%s #%d %s %s %d %d", self.peer, sid, method.decode(), path.decode(), status, nbytes)

    # -- path mapping --

    def resolve(self, path):
        """Map a request :path to a file under the root.  Returns (status, full path)."""
        path = path.split(b"?", 1)[0]
        try:
            rel = urllib.parse.unquote_to_bytes(path).decode("utf-8")
        except UnicodeDecodeError:
            return 404, None
        if "\0" in rel:
            return 404, None
        full = os.path.realpath(os.path.join(self.root, rel.lstrip("/")))
        if full != self.root and not full.startswith(self.root + os.sep):
            return 404, None      # escaped the root via .. or a symlink
        if os.path.isdir(full):
            full = os.path.join(full, INDEX_FILE)
        if not os.path.isfile(full):
            return 404, None
        return 200, full


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: bserve ROOT PORT\n")
        return 2
    root = os.path.realpath(argv[1])
    if not os.path.isdir(root):
        sys.stderr.write("bserve: %s is not a directory\n" % argv[1])
        return 2
    try:
        port = int(argv[2])
        if not 0 <= port <= 65535:
            raise ValueError
    except ValueError:
        sys.stderr.write("bserve: PORT must be 0..65535\n")
        return 2

    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind(("", port))
    listener.listen(128)
    log("listening on port %d, serving %s", listener.getsockname()[1], root)
    try:
        while True:
            sock, peer = listener.accept()
            conn = Connection(sock, peer, root)
            threading.Thread(target=conn.serve, daemon=True).start()
    except KeyboardInterrupt:
        log("interrupted, closing")
    finally:
        listener.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
